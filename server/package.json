{
  "dependencies": {
    "@scalar/express-api-reference": "0.10.26",
    "cors": "2.8.6",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "description": "CourseVault API — DecodeLabs Project 3: Database Integration (PostgreSQL via native pg driver)",
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "coursevault-server",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('package.json', 'dist/package.json')\"",
    "db:migrate": "tsx db/migrate.ts",
    "db:reset": "tsx db/reset.ts",
    "db:seed": "tsx db/seed.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "type": "module",
  "version": "1.0.0"
}