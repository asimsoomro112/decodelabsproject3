# Copy to .env and fill in. Never commit real credentials.
# Local dev (docker-compose): postgresql://coursevault:coursevault@localhost:5432/coursevault
# Managed (Neon/Supabase): paste the provider URL; add ?sslmode=require if not included.
DATABASE_URL=postgresql://coursevault:coursevault@localhost:5432/coursevault
TEST_DATABASE_URL=postgresql://coursevault:coursevault@localhost:5432/coursevault_test
CORS_ORIGINS=http://localhost:5173
DEMO_SQL_INSPECTOR=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
PORT=4000
