# CourseVault environment — copy to server/.env and fill in. Never commit real credentials.
#
# Local dev (docker-compose up -d):
#   DATABASE_URL=postgresql://coursevault:coursevault@localhost:5432/coursevault
# Managed Postgres (Neon / Supabase free tier): paste the provider URL here.
#   Neon example:   postgresql://user:password@ep-xxx.neon.tech/coursevault?sslmode=require
#   Supabase example: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://coursevault:coursevault@localhost:5432/coursevault

# Optional. When set, `npm test` runs against this database instead of DATABASE_URL,
# and it is also the default target of db:migrate / db:seed.
TEST_DATABASE_URL=postgresql://coursevault:coursevault@localhost:5432/coursevault_test

# Comma-separated CORS allowlist. The dev client runs on :5173.
CORS_ORIGINS=http://localhost:5173

# Query Inspector demo (?inspect=1 shows meta.queries). Only active when 'true'
# AND NODE_ENV is not production.
DEMO_SQL_INSPECTOR=false

# Server port.
PORT=4000

# Rate limiting: max requests per window per IP. /health and /ready are exempt.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# development | test | production
NODE_ENV=development
